  sfx:
  - displayName: "\uBFB0\uC639"
    guide: "\uBFB0\uC624\uC624\uC639\u2197 \uC810\uC810 \uB192\uAC8C"
    unlockDay: 3
    clip: {fileID: 0}
    tempSynth: 0
    icon: {fileID: 0}
    shapeSeed: 501
    meaning: "\uC0C1\uC2B9 \uC2E0\uD638. \uC804\uC6D0 \uCC9C\uC7A5\uC744 \uBCFC \uAC83.
      \uC774\uC720\uB294 \uC5C6\uB2E4."
  - displayName: "\uBFCC\uC6C5"
    guide: "\uBFCC\uC6B0\uC6B0\uC6C5\u2198 \uC810\uC810 \uB0AE\uAC8C"
    unlockDay: 6
    clip: {fileID: 0}
    tempSynth: 1
    icon: {fileID: 0}
    shapeSeed: 502
    meaning: "\uD558\uAC15 \uC2E0\uD638. \uC0AC\uB839\uAD00\uC774 \uACC4\uB2E8\uC744
      \uB0B4\uB824\uC624\uB294 \uC911."
  - displayName: "\uC090\uC090\uC090"
    guide: "\uC090! \uC090! \uC090! \uC9E7\uAC8C \uC138 \uBC88"
    unlockDay: 10
    clip: {fileID: 0}
    tempSynth: 2
    icon: {fileID: 0}
    shapeSeed: 503
    meaning: "3\uB2E8\uACC4 \uACBD\uBCF4. \uD654\uC7A5\uC2E4 \uC55E\uC5D0 \uC904
      \uC11C\uAE30 \uC2DC\uC791."
  - displayName: "\uBD80\uB974\uB974"
    guide: "\uBD80\uB974\uB974\uB974\uB974 \uC785\uC220\uC744 \uB5A8\uBA74\uC11C"
    unlockDay: 14
    clip: {fileID: 0}
    tempSynth: 3
    icon: {fileID: 0}
    shapeSeed: 504
    meaning: "\uD55C\uD30C \uACBD\uBCF4. \uB0B4\uBCF5 \uB450 \uACB9 \uCC29\uC6A9."
  - displayName: "\uBC29\uADC0"
    guide: "\uBFCC\uC9C0\uC9C1 \uB0AE\uACE0 \uC9C0\uC800\uBD84\uD558\uAC8C"
    unlockDay: 18
    clip: {fileID: 0}
    tempSynth: 4
    icon: {fileID: 0}
    shapeSeed: 505
    meaning: "(\uD574\uB3C5 \uBD88\uAC00. \uD574\uB3C5\uBCD1\uC774 \uCC3D\uBB38\uC744
      \uC5F4\uC5C8\uB2E4)"
  - displayName: "\uB760\uC694\uC639"
    guide: "\uB760\uC694\uC624\uC639~ \uB5A8\uB9AC\uAC8C"
    unlockDay: 22
    clip: {fileID: 0}
    tempSynth: 5
    icon: {fileID: 0}
    shapeSeed: 506
    meaning: "\uC6A9\uC218\uCCA0 \uBCF4\uAE09 \uC644\uB8CC. \uC5B4\uB514\uC5D0 \uC4F0\uB294\uC9C0\uB294
      \uBB3B\uC9C0 \uB9D0 \uAC83."
  hq:
    perfect:
    - "\uBCF8\uBD80: \uC644\uBCBD\uD558\uB2E4. \uBC1B\uC544 \uC801\uB358 \uD574\uB3C5\uBCD1\uC774
      \uAC10\uB3D9\uD574\uC11C \uC6B8\uC5C8\uB2E4."
    - "\uBCF8\uBD80: \uC790\uB124 \uD639\uC2DC \uC774 \uC554\uD638 \uC6D0\uC5B4\uBBFC\uC778\uAC00?"
    - "\uBCF8\uBD80: \uAE54\uB054\uD558\uB2E4. \uBC15\uC218 \uD55C \uBC88 \uCCD0
      \uC8FC\uC9C0. \uC9DD."
    - "\uBCF8\uBD80: \uC774 \uC815\uB3C4\uBA74 \uC801\uB3C4 \uBC1B\uC544 \uC801\uC5C8\uACA0\uAD70.
      \uB18D\uB2F4\uC774\uB2E4."
    good:
    - "\uBCF8\uBD80: \uC218\uC2E0 \uC591\uD638. \uACC4\uC18D\uD574."
    - "\uBCF8\uBD80: \uB300\uCDA9 \uC54C\uC544\uB4E4\uC5C8\uB2E4. \uB300\uCDA9."
    - "\uBCF8\uBD80: \uC88B\uC544. \uCE68\uC774 \uC880 \uD284 \uAC83 \uAC19\uC740\uB370
      \uB118\uC5B4\uAC00\uC9C0."
    - "\uBCF8\uBD80: \uD1B5\uACFC. \uD600\uB294 \uC880 \uD480\uACE0 \uC640\uB77C."
    bad:
    - "\uBCF8\uBD80: \uBC29\uAE08 \uADF8\uAC70 \uC7AC\uCC44\uAE30\uC600\uB098?"
    - "\uBCF8\uBD80: \uD574\uB3C5\uD574 \uBCF4\uB2C8 '\uAC10\uC790 \uC138 \uBC15\uC2A4
      \uBCF4\uB0B4\uB77C'\uB2E4. \uC774\uAC8C \uB9DE\uB098?"
    - "\uBCF8\uBD80: \uD574\uB3C5\uBCD1\uC774 \uC6C3\uB2E4\uAC00 \uC758\uC790\uC5D0\uC11C
      \uB5A8\uC5B4\uC84C\uB2E4. \uB2E4\uC2DC \uD574 \uBD10."
    - "\uBCF8\uBD80: \uC801\uB3C4 \uBABB \uC54C\uC544\uB4E3\uACA0\uAD70. \uBB38\uC81C\uB294
      \uC6B0\uB9AC\uB3C4 \uBABB \uC54C\uC544\uB4E4\uC5C8\uB2E4\uB294 \uAC70\uB2E4."
    timeout:
    - "\uBCF8\uBD80: \uC751\uB2F5\uC774 \uC5C6\uB2E4. \uADF8\uC0AC\uC774 \uC801\uC774
      \uC2E0\uD638\uB97C \uC7A1\uC558\uB2E4."
    - "\uBCF8\uBD80: \uB108\uBB34 \uC870\uC6A9\uD574\uC11C \uC878\uC558\uB098 \uD588\uB2E4.
      \uC801\uC740 \uC548 \uC878\uC558\uB2E4."
    noSpeech:
    - "\uBCF8\uBD80: \uC228\uC18C\uB9AC\uB9CC \uB4E4\uB9B0\uB2E4. \uBB34\uC12D\uB2E4."
    - "\uBCF8\uBD80: \uBC84\uD2BC\uB9CC \uB204\uB974\uBA74 \uBB50 \uD558\uB098. \uC785\uC744
      \uC368, \uC785\uC744."
    - "\uBCF8\uBD80: \uB9C8\uC774\uD06C\uB294 \uC785 \uC55E\uC5D0 \uB300\uB294 \uAC70\uB2E4.
      \uCF54 \uB9D0\uACE0."
    dayPass:
    - "\uBCF8\uBD80: \uC624\uB298 \uC791\uC804 \uB05D. \uD1F4\uADFC\uD574\uB77C.
      \uB0B4\uC77C \uBCF4\uC790."
    - "\uBCF8\uBD80: \uC218\uACE0\uD588\uB2E4. \uAC04\uC2DD\uC740 \uC5C6\uB2E4."
    - "\uBCF8\uBD80: \uC798\uD588\uB2E4. \uBBF8\uB9AC \uB9D0\uD574 \uB450\uB294\uB370,
      \uB0B4\uC77C \uC554\uD638\uB294 \uB354 \uAE38\uB2E4."
    gameOver:
    - "\uBCF8\uBD80: \uAE30\uC9C0 \uC704\uCE58\uAC00 \uD138\uB838\uB2E4. \uC790\uB124\uB294
      \uB0B4\uC77C\uBD80\uD130 \uAC10\uC790 \uB18D\uC7A5 \uADFC\uBB34\uB2E4."
    - "\uBCF8\uBD80: \uD1B5\uC2E0 \uB450\uC808. \uB2E4\uC74C \uD1B5\uC2E0\uBCD1 \uB4E4\uC5B4\uC640."
    - "\uBCF8\uBD80: \uC801\uAD70\uC774 \uC6B0\uB9AC \uC554\uD638\uB97C \uB178\uB798\uBC29
      18\uBC88\uC73C\uB85C \uC4F0\uAE30 \uC2DC\uC791\uD588\uB2E4. \uC218\uACE0\uD588\uB2E4."
    sfxGood:
    - "\uBCF8\uBD80: \uC18C\uB9AC \uD749\uB0B4 \uD569\uACA9. \uB2E4\uB4E4 \uC9C4\uC9DC\uC778
      \uC904 \uC54C\uACE0 \uB3CC\uC544\uBD24\uB2E4."
    - "\uBCF8\uBD80: \uADF8 \uC18C\uB9AC \uC5B4\uB514\uC11C \uBC30\uC6E0\uB098. \uC544\uB2C8,
      \uC548 \uBB3C\uC5B4\uBCF4\uACA0\uB2E4."
    sfxBad:
    - "\uBCF8\uBD80: \uBC29\uAE08 \uBB34\uC2A8 \uC18C\uB9AC\uC600\uB098? \uC544\uB2C8,
      \uB300\uB2F5\uD558\uC9C0 \uB9C8."
    - "\uBCF8\uBD80: \uD6A8\uACFC\uC74C \uBD88\uC77C\uCE58. \uAE30\uC9C0 \uACE0\uC591\uC774\uAC00
      \uB180\uB77C\uC11C \uB3C4\uB9DD\uAC14\uB2E4."
    - "\uBCF8\uBD80: \uADF8 \uC18C\uB9AC \uB4E3\uACE0 \uC801\uAD70\uC774 \uAD6C\uAE09\uCC28\uB97C
      \uBD88\uB800\uB2E4."
    heardBad:
    - "\uBCF8\uBD80: '{heard}'? \uC6B0\uB9AC \uC554\uD638\uCC45\uC5D0 \uADF8\uB7F0
      \uB9D0\uC740 \uC5C6\uB2E4."
    - "\uBCF8\uBD80: \uD574\uB3C5 \uACB0\uACFC '{heard}'. \uB0B4 \uACE0\uAC1C\uAC00
      45\uB3C4\uB85C \uAEBE\uC600\uB2E4."
    - "\uBCF8\uBD80: '{heard}'\uB77C\uB2C8. \uC810\uC2EC \uBA54\uB274\uB97C \uBCF4\uB0B8
      \uAC74\uAC00?"
    - "\uBCF8\uBD80: \uAE30\uB2E4\uB9B0 \uAC74 '{target}', \uB3C4\uCC29\uD55C \uAC74
      '{heard}'."
    heardGood:
    - "\uBCF8\uBD80: '{heard}'\uB85C \uB4E4\uB838\uB2E4. \uBE44\uC2B7\uD558\uB2C8\uAE4C
      \uBD10\uC900\uB2E4."
    - "\uBCF8\uBD80: '{heard}'. \uC544\uC2AC\uC544\uC2AC\uD558\uB2E4. \uC624\uB298\uB9CC
      \uB118\uC5B4\uAC04\uB2E4."
    briefing:
    - "\uBCF8\uBD80: \uC2E0\uC785, \uC798 \uC654\uB2E4. \uC554\uD638 \uC7A5\uBE44\uAC00
      \uACE0\uC7A5 \uB098\uC11C \uC624\uB298\uBD80\uD130 \uC790\uB124 \uC785\uC774
      \uBB34\uC804\uAE30\uB2E4."
    - "\uBCF8\uBD80: \uC624\uB298\uB3C4 \uC801\uC774 \uC5FF\uB4E3\uACE0 \uC788\uB2E4.
      \uB610\uBC15\uB610\uBC15, \uBE60\uB974\uAC8C."
    - "\uBCF8\uBD80: \uC5B4\uC81C\uBCF4\uB2E4 \uAE38\uB2E4. \uD600 \uAF2C\uC774\uBA74
      \uAE30\uC9C0\uB3C4 \uAF2C\uC778\uB2E4."
    - "\uBCF8\uBD80: \uC554\uD638\uD45C \uC798 \uBD10 \uB46C\uB77C. \uC801\uC740
      \uC548 \uAE30\uB2E4\uB824 \uC900\uB2E4."
    - "\uBCF8\uBD80: \uC5B4\uC81C \uC1A1\uC2E0 \uC798 \uB4E4\uC5C8\uB2E4. \uC6C3\uC74C
      \uCC38\uB290\uB77C \uD63C\uB0AC\uB2E4."
    - "\uBCF8\uBD80: \uBB3C \uD55C \uC794 \uB9C8\uC2DC\uACE0 \uC2DC\uC791\uD574.
      \uC785\uC774 \uB9C8\uB974\uBA74 \uC554\uD638\uB3C4 \uB9C8\uB978\uB2E4."
  ranks:
  - day: 1
    name: "\uD6C8\uB828\uBCD1"
  - day: 2
    name: "\uC774\uB4F1\uBCD1"
  - day: 3
    name: "\uC77C\uBCD1"
